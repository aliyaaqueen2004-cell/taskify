{
    "version": 2,
    "builds": [
        {
            "src": "frontend/**",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "frontend/dist"
            }
        },
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "^/api/(.*)",
            "dest": "/backend/server.js"
        },
        {
            "src": "^/socket.io/(.*)",
            "dest": "/backend/server.js"
        },
        {
            "src": "^/(?!frontend/dist/)(.*)",
            "dest": "/frontend/dist/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "^/(.*)",
            "dest": "/frontend/dist/index.html"
        }
    ]
}